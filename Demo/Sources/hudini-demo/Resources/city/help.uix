<?xml version="1.0" encoding="UTF-8"?>
<!-- Help, a window that stays open, minimizes, and resizes by the grip in its corner. The host
     fills the read-only text, and the area and its slider follow the window's edges. -->
<UIScript version="1">
  <Window width="320" height="200" minWidth="240" minHeight="120" resizable="true"/>

  <TextArea name="helpText" x="8" y="8" width="286" height="184" readOnly="true"
            edgeOffsetLeft="8" edgeOffsetRight="26" edgeOffsetTop="8" edgeOffsetBottom="8"/>
  <Slider name="helpScroll" x="298" y="8" width="14" height="168" scrolls="helpText"
          edgeOffsetRight="8" edgeOffsetTop="8" edgeOffsetBottom="24"/>
</UIScript>
