<?xml version="1.0" encoding="UTF-8"?>
<!-- The tool palette, a HUD panel along the map's top left. It never stacks with windows, so the
     host draws it outside the WindowManager. The tools are a grid: the zones as circles in the
     colors the map draws them, and the other tools as plain tiles. A click chooses a tool and the
     grid rings it; resting on a tool names it. -->
<UIScript version="1">
  <Window width="104" height="170"/>

  <Style name="heading" textColor="accent"/>
  <Style name="note" textColor="secondaryText" fontSize="caption"/>

  <Text name="heading" x="8" y="6" width="88" height="16" style="heading" text="Tools"/>
  <Grid name="tools" x="5" y="26" width="94" height="104" itemWidth="42" itemHeight="30" spacing="4"
        titles="none">
    <Item name="residential" color="#5AAA5F" title="Homes"/>
    <Item name="commercial" color="#5082D2" title="Shops"/>
    <Item name="industrial" color="#CDAF50" title="Industry"/>
    <Item name="road" title="Road"/>
    <Item name="park" title="Park"/>
    <Item name="bulldoze" title="Doze"/>
  </Grid>
  <Text name="toolName" x="8" y="136" width="88" height="28" style="note"/>
</UIScript>
