<?xml version="1.0" encoding="UTF-8"?>
<!-- A yes-or-no question, shown as a modal window that dims what's behind it. One window serves
     every question: whoever asks gives it the question and what to do with the answer. -->
<UIScript version="1">
  <Window width="300" height="112"/>

  <Text name="message" x="14" y="14" width="272" height="40"/>
  <Button name="no" x="96" y="74" width="90" height="26" text="No"/>
  <Button name="yes" x="196" y="74" width="90" height="26" text="Yes"/>
</UIScript>
